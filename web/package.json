{
  "name": "sapphire-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name sapphire-guild --branch main --commit-dirty=true",
    "check:server": "tsc -p functions/tsconfig.json",
    "accounts": "node scripts/make-accounts.mjs",
    "dev:accounts": "vite build && wrangler pages dev dist --port 8788 --ip 127.0.0.1"
  },
  "dependencies": {
    "galmuri": "2.40.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "wrangler": "4.155.0"
  }
}
