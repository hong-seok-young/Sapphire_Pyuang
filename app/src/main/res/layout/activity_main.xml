<?xml version="1.0" encoding="utf-8"?>
<!-- 첫 화면: 위쪽 메뉴 줄 + 길드 위키 웹앱 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/web_night"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/web_bar"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        android:visibility="gone"
        app:popupTheme="@style/ThemeOverlay.Sapphire.Menu"
        app:title="@string/main_title"
        app:titleTextColor="#FFFFFF" />
    <!-- 윗줄은 평소 숨긴다. 앱 기능은 위키 아래 탭 '앱'에 있다.
         예전 위키(앱 탭이 없는 버전)이거나 인터넷이 안 될 때만 보인다 (MainActivity) -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/web_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:max="100"
            android:progressTint="#6F8FFF"
            android:visibility="gone" />

        <!-- 인터넷이 안 될 때 -->
        <LinearLayout
            android:id="@+id/offline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/web_night"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/offline_title"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/offline_msg"
                android:textColor="#A9A2CF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/retry" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
