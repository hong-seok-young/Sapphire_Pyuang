<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FloatingClock" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#1E88E5</item>
        <item name="colorOnPrimary">#FFFFFF</item>
    </style>

    <!-- 첫 화면(위키): 웹앱과 같은 어두운 색으로 상태바, 아래 버튼 줄까지 맞춘다 -->
    <style name="Theme.Sapphire.Web" parent="Theme.FloatingClock">
        <item name="android:windowBackground">@color/web_night</item>
        <item name="android:statusBarColor">@color/web_bar</item>
        <item name="android:navigationBarColor">@color/web_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <!-- 윗줄 ⋮ 메뉴: 위키 패널과 같은 남보라 바탕에 밝은 글씨 (밝은 기본 바탕에 흰 글씨로 떠서 안 보였다) -->
    <style name="ThemeOverlay.Sapphire.Menu" parent="ThemeOverlay.Material3.Dark">
        <item name="colorSurface">@color/web_panel</item>
        <item name="colorSurfaceContainer">@color/web_panel</item>
        <item name="colorOnSurface">@color/web_text</item>
        <item name="android:colorBackground">@color/web_panel</item>
        <item name="android:textColorPrimary">@color/web_text</item>
    </style>
</resources>
