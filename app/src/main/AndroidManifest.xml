<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 다른 앱 위에 표시 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 포그라운드 서비스 (게임 중에도 시계가 안 죽게) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 안드로이드 13+ 알림 표시 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 앱 내 업데이트: 새 버전 확인/다운로드 및 설치 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 안드로이드 12+: 이 앱이 자기 자신을 업데이트할 때는 설치 확인 창 없이 (UpdateInstaller) -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- 게임 감지: 지금 화면 앞에 떠 있는 앱 확인 ('사용 정보 접근', 사용자가 설정에서 직접 허용) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- 재부팅/업데이트 뒤 켜 두었던 시계 자동 재시작 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 타이머 알림 진동 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 게임 선택 목록: 홈 화면 아이콘이 있는 앱만 조회 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FloatingClock">

        <!-- 첫 화면: 길드 위키 웹앱. 홈 화면 아이콘이 가리키는 이름이라 바꾸지 않는다 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Sapphire.Web">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 시계 설정 (첫 화면 위쪽 메뉴의 '⏰ 시계', 시계 알림을 누를 때) -->
        <activity
            android:name=".ClockActivity"
            android:exported="false"
            android:label="@string/clock_title"
            android:launchMode="singleTop" />

        <activity
            android:name=".TimerActivity"
            android:exported="false"
            android:label="@string/timer_title" />

        <service
            android:name=".FloatingClockService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating clock overlay shown over other apps" />
        </service>

        <!-- 알림창 빠른 설정의 '시계' 켜기/끄기 버튼 (시스템 화면만 연결할 수 있다) -->
        <service
            android:name=".ClockTileService"
            android:exported="true"
            android:icon="@drawable/ic_clock"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- 재부팅/업데이트 뒤 자동 재시작 (시스템만 보낼 수 있는 방송) -->
        <receiver
            android:name=".StartupReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 업데이트 설치 결과 (안드로이드 설치 프로그램이 이 앱의 PendingIntent 로 보낸다) -->
        <receiver
            android:name=".UpdateResultReceiver"
            android:exported="false" />

        <!-- 다운로드한 업데이트 APK를 설치 프로그램에 넘기기 위한 FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
